# Copy this file to .env and fill in your keys. .env is gitignored.
# Used by the live test suite (pytest -m live) and the backend examples.

# OpenAI (or any OpenAI-compatible endpoint)
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini
# Optional: override for a compatible endpoint (Groq, Together, vLLM, ...)
# OPENAI_BASE_URL=https://api.openai.com/v1

# Anthropic (Messages API)
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-sonnet-4-20250514
# Only needed for an org-level (unscoped) key; workspace-scoped keys omit this.
# ANTHROPIC_WORKSPACE_ID=wrkspc_...

# Kiro agent id (a valid v3 session mode, e.g. vibe / spec / developer)
KIRO_AGENT=vibe
